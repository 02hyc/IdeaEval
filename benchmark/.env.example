# =============================================================================
# Main LLM ("batch" client) - paper assignment, pseudo-labelling, subtopic
# assignment, coherence verification. All these calls send thinking="disabled".
# Recommended: a fast, cheap model (default `deepseek-v4-pro` via DeepSeek API).
# =============================================================================
OPENAI_API_KEY=sk-your-batch-api-key
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-pro

# Connection tuning (optional)
OPENAI_MAX_CONNECTIONS=512
OPENAI_MAX_KEEPALIVE_CONNECTIONS=256
OPENAI_TIMEOUT_SECONDS=600
LLM_RPM=18000

# =============================================================================
# Thinking LLM (quality-critical calls) - initial taxonomy, dedup, subtopic
# discovery, final-label generation. Falls back to the main LLM if unset.
# In our setup the model name is the same as LLM_MODEL; only the endpoint
# differs (a relay that forces thinking mode regardless of the request body).
# =============================================================================
THINKING_API_KEY=sk-your-thinking-api-key
THINKING_BASE_URL=https://your-thinking-endpoint.example.com/v1
THINKING_MODEL=deepseek-v4-pro
LLM_REASONING_EFFORT=high

# =============================================================================
# External services
# =============================================================================
# PDF-to-Markdown conversion (SoMark API) - Stage 0b only. Skip it by placing
# your own markdowns in data/markdown/ (see docs/PIPELINE.md for alternatives).
SOMARK_AUTH_USER=your-somark-user
SOMARK_AUTH_PASSWORD=your-somark-password

# Semantic Scholar API keys (comma-separated for multi-key rate limiting)
S2_API_KEYS=key1,key2,key3
# Single key + base URL used by scripts/update_citation_counts.py and check_date_leaks.py
S2_API_KEY=
# S2_API_BASE=https://api.semanticscholar.org

# Web search (used by deep review and date-cutoff filter)
SERPER_API_KEY=your-serper-key
TAVILY_API_KEY=your-tavily-key

# Paper2Proposal (Anthropic API) - Stage 4 only. ANTHROPIC_BASE_URL is optional.
ANTHROPIC_API_KEY=sk-ant-your-key
# ANTHROPIC_BASE_URL=

# Path overrides (normally configured in config.yaml paths section)
# MARKDOWN_DIR=./data/markdown
# METADATA_FILE=./data/arxiv/arxiv_2025sep_2026jan_metadata_filtered.jsonl
# DATA_DIR=./data
